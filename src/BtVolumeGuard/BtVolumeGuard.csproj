<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\BtVolumeGuard.Core\BtVolumeGuard.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Regenerate with tools/make-icon.ps1 after changing TrayIconRenderer. -->
    <ApplicationIcon>BtVolumeGuard.ico</ApplicationIcon>
    <Version>0.2.1</Version>
    <Product>BtVolumeGuard</Product>
    <Authors>Alexander Skrinnik</Authors>
    <Copyright>Copyright (c) 2026 Alexander Skrinnik. MIT License.</Copyright>
    <Description>Reverts Bluetooth headset volume jumps to 100% at the start of a call.</Description>
  </PropertyGroup>

</Project>